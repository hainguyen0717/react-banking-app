{
  "openapi": "3.0.3",
  "info": {
    "title": "Express Bank Demo API",
    "version": "5.3.0",
    "description": "Deterministic customer profile, opaque-session, account, immediate/scheduled transfer, Payments (bank account, email PayID and BPAY), demo card, and test-delay APIs. Protected actor identity is derived from a verified opaque session supplied either as Authorization: Bearer <token> or as the eb_session HttpOnly cookie. An explicit Authorization header is authoritative. Bearer-authenticated mutations are suitable for non-browser integration tests and bypass browser Origin checks; cookie-authenticated mutations and public delay-control mutations require a configured trusted Origin. Operations with required JSON bodies require Content-Type: application/json (an optional UTF-8 charset is accepted)."
  },
  "servers": [
    {
      "url": "/",
      "description": "The origin serving this contract and Swagger UI"
    }
  ],
  "paths": {
    "/api/login": {
      "post": {
        "summary": "Log in an active customer",
        "tags": ["Customers"],
        "security": [],
        "requestBody": {
          "required": true,
          "content": { "application/json": { "schema": { "$ref": "#/components/schemas/LoginRequest" } } }
        },
        "responses": {
          "200": { "description": "Safe customer profile plus the same opaque session token in a bearer-friendly response envelope and HttpOnly cookie", "headers": { "Set-Cookie": { "schema": { "type": "string", "example": "eb_session=opaque; Path=/; HttpOnly; SameSite=Lax" } }, "Cache-Control": { "schema": { "type": "string", "example": "no-store, no-cache, must-revalidate" } }, "Pragma": { "schema": { "type": "string", "example": "no-cache" } } }, "content": { "application/json": { "schema": { "$ref": "#/components/schemas/LoginResponse" } } } },
          "400": { "$ref": "#/components/responses/Error" },
          "401": { "$ref": "#/components/responses/Error" },
          "403": { "$ref": "#/components/responses/Error" },
          "415": { "$ref": "#/components/responses/UnsupportedMediaType" }
        }
      }
    },
    "/api/customers": {
      "post": {
        "summary": "Create a customer",
        "tags": ["Customers"],
        "security": [],
        "requestBody": {
          "required": true,
          "content": { "application/json": { "schema": { "$ref": "#/components/schemas/CreateCustomerRequest" } } }
        },
        "responses": {
          "201": { "description": "Customer created", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/Customer" } } } },
          "400": { "$ref": "#/components/responses/Error" },
          "403": { "$ref": "#/components/responses/Error" },
          "409": { "$ref": "#/components/responses/Error" },
          "415": { "$ref": "#/components/responses/UnsupportedMediaType" }
        }
      }
    },
    "/api/session": {
      "get": {
        "summary": "Return the authenticated safe customer profile and refresh idle activity",
        "tags": ["Sessions"],
        "security": [{ "bearerAuth": [] }, { "cookieAuth": [] }],
        "responses": {
          "200": { "description": "Authenticated customer profile", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/Customer" } } } },
          "401": { "$ref": "#/components/responses/Unauthorized" }
        }
      }
    },
    "/api/logout": {
      "post": {
        "summary": "Revoke only the selected session and clear a matching cookie",
        "tags": ["Sessions"],
        "security": [{ "bearerAuth": [] }, { "cookieAuth": [] }],
        "responses": {
          "204": { "description": "Selected session revoked. A matching browser cookie is cleared; an unrelated cookie is left intact.", "headers": { "Set-Cookie": { "description": "Present only when the request carried a cookie for the selected session.", "schema": { "type": "string" } } } },
          "401": { "$ref": "#/components/responses/Unauthorized" },
          "403": { "$ref": "#/components/responses/Error" }
        }
      }
    },
    "/api/profile": {
      "put": {
        "summary": "Update the authenticated customer's personal information",
        "tags": ["Customers"], "security": [{ "bearerAuth": [] }, { "cookieAuth": [] }],
        "requestBody": { "required": true, "content": { "application/json": { "schema": { "$ref": "#/components/schemas/UpdateProfileRequest" } } } },
        "responses": { "200": { "description": "Updated safe profile", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/Customer" } } } }, "400": { "$ref": "#/components/responses/Error" }, "401": { "$ref": "#/components/responses/Unauthorized" }, "403": { "$ref": "#/components/responses/Error" }, "415": { "$ref": "#/components/responses/UnsupportedMediaType" } }
      }
    },
    "/api/accounts": {
      "get": {
        "summary": "List a customer's personal and jointly owned accounts",
        "description": "Each shared account is returned once with the same ID, balance, owners, and history for either owner.",
        "tags": ["Accounts"],
        "security": [{ "bearerAuth": [] }, { "cookieAuth": [] }],
        "responses": {
          "200": { "description": "Account list", "content": { "application/json": { "schema": { "type": "object", "required": ["accounts"], "properties": { "accounts": { "type": "array", "items": { "$ref": "#/components/schemas/Account" } } } } } } },
          "401": { "$ref": "#/components/responses/Unauthorized" },
          "404": { "$ref": "#/components/responses/Error" },
          "409": { "$ref": "#/components/responses/Error" }
        }
      },
      "post": {
        "summary": "Create an AUD deposit account with the configured opening balance",
        "tags": ["Accounts"],
        "security": [{ "bearerAuth": [] }, { "cookieAuth": [] }],
        "requestBody": {
          "required": true,
          "content": { "application/json": { "schema": { "$ref": "#/components/schemas/CreateAccountRequest" } } }
        },
        "responses": {
          "201": { "description": "Account created", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/Account" } } } },
          "400": { "$ref": "#/components/responses/Error" },
          "401": { "$ref": "#/components/responses/Unauthorized" },
          "403": { "$ref": "#/components/responses/Error" },
          "404": { "$ref": "#/components/responses/Error" },
          "409": { "$ref": "#/components/responses/Error" },
          "415": { "$ref": "#/components/responses/UnsupportedMediaType" }
        }
      }
    },
    "/api/joint-accounts": {
      "post": {
        "summary": "Create one joint AUD account shared by two active registered customers",
        "description": "The server resolves the co-owner by normalized email and applies the configured opening balance once. Both owners receive equal view and transfer access immediately; no invitation step is used.",
        "tags": ["Accounts"],
        "security": [{ "bearerAuth": [] }, { "cookieAuth": [] }],
        "requestBody": {
          "required": true,
          "content": { "application/json": { "schema": { "$ref": "#/components/schemas/CreateJointAccountRequest" } } }
        },
        "responses": {
          "201": { "description": "Joint account created", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/Account" } } } },
          "400": { "$ref": "#/components/responses/Error" },
          "401": { "$ref": "#/components/responses/Unauthorized" },
          "403": { "$ref": "#/components/responses/Error" },
          "404": { "$ref": "#/components/responses/Error" },
          "409": { "$ref": "#/components/responses/Error" },
          "415": { "$ref": "#/components/responses/UnsupportedMediaType" }
        }
      }
    },
    "/api/transfers": {
      "post": {
        "summary": "Atomically transfer AUD cents between accounts",
        "tags": ["Transfers"],
        "security": [{ "bearerAuth": [] }, { "cookieAuth": [] }],
        "requestBody": {
          "required": true,
          "content": { "application/json": { "schema": { "$ref": "#/components/schemas/CreateTransferRequest" } } }
        },
        "responses": {
          "201": { "description": "Transfer completed", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/Transfer" } } } },
          "400": { "$ref": "#/components/responses/Error" },
          "401": { "$ref": "#/components/responses/Unauthorized" },
          "403": { "$ref": "#/components/responses/Error" },
          "404": { "$ref": "#/components/responses/Error" },
          "409": { "$ref": "#/components/responses/Error" },
          "415": { "$ref": "#/components/responses/UnsupportedMediaType" }
        }
      }
    },
    "/api/payments/resolve": {
      "post": {
        "summary": "Resolve and validate an immediate AUD payment for review",
        "description": "Passive validation only; no balances or records change. PayID responses contain the normalized PayID and safe display name, never its mapped account.",
        "tags": ["Payments"],
        "security": [{ "bearerAuth": [] }, { "cookieAuth": [] }],
        "requestBody": { "required": true, "content": { "application/json": { "schema": { "$ref": "#/components/schemas/PaymentRequest" } } } },
        "responses": {
          "200": { "description": "Safe payment review", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/PaymentResolution" } } } },
          "400": { "$ref": "#/components/responses/Error" },
          "401": { "$ref": "#/components/responses/Unauthorized" },
          "403": { "$ref": "#/components/responses/Error" },
          "404": { "$ref": "#/components/responses/Error" },
          "409": { "$ref": "#/components/responses/Error" },
          "415": { "$ref": "#/components/responses/UnsupportedMediaType" }
        }
      }
    },
    "/api/payments": {
      "post": {
        "summary": "Confirm an immediate AUD payment",
        "description": "Re-resolves the destination and authorization inside the confirmation transaction. Bank-account and PayID payments debit and credit internal accounts atomically; BPAY records a source-only debit. The immutable response is the receipt.",
        "tags": ["Payments"],
        "security": [{ "bearerAuth": [] }, { "cookieAuth": [] }],
        "requestBody": { "required": true, "content": { "application/json": { "schema": { "$ref": "#/components/schemas/PaymentRequest" } } } },
        "responses": {
          "201": { "description": "Payment receipt", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/PaymentReceipt" } } } },
          "400": { "$ref": "#/components/responses/Error" },
          "401": { "$ref": "#/components/responses/Unauthorized" },
          "403": { "$ref": "#/components/responses/Error" },
          "404": { "$ref": "#/components/responses/Error" },
          "409": { "$ref": "#/components/responses/Error" },
          "415": { "$ref": "#/components/responses/UnsupportedMediaType" }
        }
      }
    },
    "/api/accounts/{accountId}/transactions": {
      "get": {
        "summary": "List transfers for a personal or jointly owned account, newest first",
        "tags": ["Transfers"],
        "security": [{ "bearerAuth": [] }, { "cookieAuth": [] }],
        "parameters": [
          { "in": "path", "name": "accountId", "required": true, "schema": { "type": "string", "format": "uuid" } }
        ],
        "responses": {
          "200": { "description": "Directional transaction history", "content": { "application/json": { "schema": { "type": "object", "required": ["transactions"], "properties": { "transactions": { "type": "array", "items": { "$ref": "#/components/schemas/Transaction" } } } } } } },
          "401": { "$ref": "#/components/responses/Unauthorized" },
          "403": { "$ref": "#/components/responses/Error" },
          "404": { "$ref": "#/components/responses/Error" }
        }
      }
    },
    "/api/scheduled-transfers": {
      "get": {
        "summary": "List the authenticated customer's scheduled transfers", "tags": ["Transfers"], "security": [{ "bearerAuth": [] }, { "cookieAuth": [] }],
        "responses": { "200": { "description": "Customer-private schedule list", "content": { "application/json": { "schema": { "type": "object", "properties": { "scheduledTransfers": { "type": "array", "items": { "$ref": "#/components/schemas/ScheduledTransfer" } } } } } } }, "401": { "$ref": "#/components/responses/Unauthorized" } }
      },
      "post": {
        "summary": "Schedule a one-time future transfer without reserving funds", "tags": ["Transfers"], "security": [{ "bearerAuth": [] }, { "cookieAuth": [] }],
        "requestBody": { "required": true, "content": { "application/json": { "schema": { "$ref": "#/components/schemas/CreateScheduledTransferRequest" } } } },
        "responses": { "201": { "description": "Pending transfer schedule", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/ScheduledTransfer" } } } }, "400": { "$ref": "#/components/responses/Error" }, "401": { "$ref": "#/components/responses/Unauthorized" }, "403": { "$ref": "#/components/responses/Error" }, "404": { "$ref": "#/components/responses/Error" }, "409": { "$ref": "#/components/responses/Error" }, "415": { "$ref": "#/components/responses/UnsupportedMediaType" } }
      }
    },
    "/api/cards": {
      "get": { "summary": "List holder-owned demo debit cards", "tags": ["Cards"], "security": [{ "bearerAuth": [] }, { "cookieAuth": [] }], "responses": { "200": { "description": "Cards with five display-only sample transactions each" }, "401": { "$ref": "#/components/responses/Unauthorized" } } },
      "post": { "summary": "Open a demo debit card linked to an owned account", "tags": ["Cards"], "security": [{ "bearerAuth": [] }, { "cookieAuth": [] }], "requestBody": { "required": true, "content": { "application/json": { "schema": { "type": "object", "required": ["accountId"], "properties": { "accountId": { "type": "string", "format": "uuid" } } } } } }, "responses": { "201": { "description": "Active masked card with five sample transactions", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/Card" } } } }, "400": { "$ref": "#/components/responses/Error" }, "401": { "$ref": "#/components/responses/Unauthorized" }, "403": { "$ref": "#/components/responses/Error" }, "404": { "$ref": "#/components/responses/Error" }, "415": { "$ref": "#/components/responses/UnsupportedMediaType" } } }
    },
    "/api/cards/{cardId}": {
      "get": { "summary": "Get one holder-owned masked card", "tags": ["Cards"], "security": [{ "bearerAuth": [] }, { "cookieAuth": [] }], "parameters": [{ "in": "path", "name": "cardId", "required": true, "schema": { "type": "string", "format": "uuid" } }], "responses": { "200": { "description": "Masked card", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/Card" } } } }, "401": { "$ref": "#/components/responses/Unauthorized" }, "403": { "$ref": "#/components/responses/Error" }, "404": { "$ref": "#/components/responses/Error" } } }
    },
    "/api/cards/{cardId}/lock": {
      "post": { "summary": "Temporarily lock an active holder-owned card", "tags": ["Cards"], "security": [{ "bearerAuth": [] }, { "cookieAuth": [] }], "parameters": [{ "in": "path", "name": "cardId", "required": true, "schema": { "type": "string", "format": "uuid" } }], "responses": { "200": { "description": "Locked masked card", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/Card" } } } }, "401": { "$ref": "#/components/responses/Unauthorized" }, "403": { "$ref": "#/components/responses/Error" }, "404": { "$ref": "#/components/responses/Error" }, "409": { "$ref": "#/components/responses/Error" } } }
    },
    "/api/cards/{cardId}/unlock": {
      "post": { "summary": "Unlock a locked holder-owned card", "tags": ["Cards"], "security": [{ "bearerAuth": [] }, { "cookieAuth": [] }], "parameters": [{ "in": "path", "name": "cardId", "required": true, "schema": { "type": "string", "format": "uuid" } }], "responses": { "200": { "description": "Active masked card", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/Card" } } } }, "401": { "$ref": "#/components/responses/Unauthorized" }, "403": { "$ref": "#/components/responses/Error" }, "404": { "$ref": "#/components/responses/Error" }, "409": { "$ref": "#/components/responses/Error" } } }
    },
    "/api/cards/{cardId}/disable": {
      "post": { "summary": "Permanently disable an active or locked holder-owned card", "tags": ["Cards"], "security": [{ "bearerAuth": [] }, { "cookieAuth": [] }], "parameters": [{ "in": "path", "name": "cardId", "required": true, "schema": { "type": "string", "format": "uuid" } }], "responses": { "200": { "description": "Disabled masked card", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/Card" } } } }, "401": { "$ref": "#/components/responses/Unauthorized" }, "403": { "$ref": "#/components/responses/Error" }, "404": { "$ref": "#/components/responses/Error" }, "409": { "$ref": "#/components/responses/Error" } } }
    },
    "/api/test-controls/delay": {
      "get": {
        "summary": "Read the process-local test delay",
        "description": "This control request is never delayed and requires no session. The inclusive whole-second range is shared by all users and resets to 0–0 seconds with BOTH scope when the server process restarts.",
        "tags": ["Test Controls"],
        "security": [],
        "responses": {
          "200": { "description": "Current delay setting", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/DelaySetting" } } } }
        }
      },
      "put": {
        "summary": "Replace the process-local test delay",
        "description": "Requires a trusted Origin but no session. All three fields are required and invalid payloads leave the previous setting unchanged. This control request is never delayed. Each eligible event samples an inclusive whole-number value; equal bounds produce a fixed delay.",
        "tags": ["Test Controls"],
        "security": [],
        "requestBody": {
          "required": true,
          "content": { "application/json": { "schema": { "$ref": "#/components/schemas/DelaySetting" } } }
        },
        "responses": {
          "200": { "description": "Saved delay setting", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/DelaySetting" } } } },
          "400": { "$ref": "#/components/responses/Error" },
          "403": { "$ref": "#/components/responses/Error" },
          "415": { "$ref": "#/components/responses/UnsupportedMediaType" }
        }
      }
    },
    "/api/test-controls/delay/sample": {
      "post": {
        "summary": "Reserve one API delay sample",
        "description": "Requires a trusted Origin but no session and is never delayed. The response is not cacheable. Send the opaque ticket exactly once as X-Test-Delay-Ticket on the next ordinary /api request. Tickets are short-lived; invalid, expired, or replayed values return 400 from that ordinary request. Its response exposes the applied whole-second value as X-Test-Delay-Seconds.",
        "tags": ["Test Controls"],
        "security": [],
        "responses": {
          "200": {
            "description": "Reserved single-use delay sample",
            "headers": { "Cache-Control": { "schema": { "type": "string", "example": "no-store" } } },
            "content": { "application/json": { "schema": { "$ref": "#/components/schemas/DelaySample" } } }
          },
          "403": { "$ref": "#/components/responses/Error" }
        }
      }
    },
    "/api/health": {
      "get": {
        "summary": "Check API and database health",
        "tags": ["Operations"],
        "security": [],
        "responses": { "200": { "description": "Healthy" }, "503": { "description": "Database unavailable" } }
      }
    },
    "/docs": {
      "get": {
        "summary": "Redirect to the canonical Swagger UI URL",
        "tags": ["Operations"],
        "security": [],
        "responses": { "308": { "description": "Permanent redirect to /docs/" } }
      }
    },
    "/docs/": {
      "get": {
        "summary": "Render the browser-friendly Swagger UI",
        "description": "Loads locally bundled Swagger UI assets and fetches /docs/openapi.json. Try it out uses browser-managed credentials; no cookie, password, or authorization value is preloaded or persisted by the UI.",
        "tags": ["Operations"],
        "security": [],
        "responses": { "200": { "description": "Swagger UI HTML" } }
      }
    },
    "/docs/openapi.json": {
      "get": {
        "summary": "Return this OpenAPI document",
        "tags": ["Operations"],
        "security": [],
        "responses": { "200": { "description": "OpenAPI 3.0 JSON document" } }
      }
    }
  },
  "components": {
    "parameters": {
      "TestDelayTicket": {
        "in": "header",
        "name": "X-Test-Delay-Ticket",
        "required": false,
        "description": "Opaque short-lived ticket reserved by POST /api/test-controls/delay/sample. It is consumed once by an ordinary /api request; omit it to sample directly at request entry.",
        "schema": { "type": "string", "maxLength": 256 }
      }
    },
    "headers": {
      "TestDelaySeconds": {
        "description": "Whole seconds sampled and applied to this ordinary API response.",
        "schema": { "type": "integer", "minimum": 0, "maximum": 60 }
      }
    },
    "securitySchemes": {
      "bearerAuth": {
        "type": "http",
        "scheme": "bearer",
        "bearerFormat": "Opaque session token",
        "description": "Use the accessToken returned by POST /api/login. The token is opaque, is not a JWT, and represents the same revocable session as the cookie. If Authorization is supplied it is authoritative; invalid bearer credentials never fall back to a cookie."
      },
      "cookieAuth": {
        "type": "apiKey",
        "in": "cookie",
        "name": "eb_session",
        "description": "Opaque HttpOnly session cookie set by POST /api/login. Browsers send it automatically for same-origin requests; JavaScript and Swagger UI cannot read or preload it. Only its SHA-256 hash is persisted server-side."
      }
    },
    "responses": {
      "Error": {
        "description": "Request rejected",
        "content": { "application/json": { "schema": { "$ref": "#/components/schemas/ErrorResponse" } } }
      },
      "Unauthorized": {
        "description": "Missing, malformed, unknown, expired, revoked, or inactive authentication",
        "headers": { "WWW-Authenticate": { "schema": { "type": "string", "example": "Bearer realm=\"express-bank\"" } } },
        "content": { "application/json": { "schema": { "$ref": "#/components/schemas/ErrorResponse" } } }
      },
      "UnsupportedMediaType": {
        "description": "A required request body was not sent as application/json",
        "content": { "application/json": { "schema": { "$ref": "#/components/schemas/ErrorResponse" }, "example": { "error": "Content-Type must be application/json." } } }
      }
    },
    "schemas": {
      "DelaySetting": {
        "type": "object",
        "additionalProperties": false,
        "required": ["minSeconds", "maxSeconds", "scope"],
        "properties": {
          "minSeconds": { "type": "integer", "minimum": 0, "maximum": 60, "example": 2 },
          "maxSeconds": { "type": "integer", "minimum": 0, "maximum": 60, "example": 5 },
          "scope": { "type": "string", "enum": ["API", "UI", "BOTH"] }
        }
      },
      "DelaySample": {
        "type": "object",
        "additionalProperties": false,
        "required": ["ticket", "sampledSeconds"],
        "properties": {
          "ticket": { "type": "string", "description": "Opaque short-lived single-use reservation." },
          "sampledSeconds": { "type": "integer", "minimum": 0, "maximum": 60 }
        }
      },
      "LoginRequest": {
        "type": "object",
        "required": ["email", "password"],
        "properties": {
          "email": { "type": "string", "format": "email" },
          "password": { "type": "string", "format": "password" }
        }
      },
      "LoginResponse": {
        "type": "object",
        "additionalProperties": false,
        "required": ["customer", "accessToken", "tokenType", "expiresAt"],
        "properties": {
          "customer": { "$ref": "#/components/schemas/Customer" },
          "accessToken": { "type": "string", "description": "Opaque session token for Authorization: Bearer. It is not a JWT." },
          "tokenType": { "type": "string", "enum": ["Bearer"] },
          "expiresAt": { "type": "string", "format": "date-time", "description": "Absolute session expiry. Idle expiry may end the session sooner." }
        }
      },
      "CreateCustomerRequest": {
        "type": "object",
        "required": ["email", "password", "firstName", "lastName"],
        "properties": {
          "email": { "type": "string", "format": "email" },
          "password": { "type": "string", "format": "password", "minLength": 8 },
          "firstName": { "type": "string", "maxLength": 100 },
          "lastName": { "type": "string", "maxLength": 100 }
        }
      },
      "Customer": {
        "type": "object",
        "required": ["id", "email", "firstName", "lastName"],
        "properties": {
          "id": { "type": "string", "format": "uuid" },
          "email": { "type": "string", "format": "email" },
          "firstName": { "type": "string" },
          "lastName": { "type": "string" },
          "address": { "type": "string", "maxLength": 250, "nullable": true },
          "phoneNumber": { "type": "string", "nullable": true },
          "dateOfBirth": { "type": "string", "format": "date-time", "nullable": true },
          "lastLoginAt": { "type": "string", "format": "date-time", "nullable": true }
        }
      },
      "UpdateProfileRequest": {
        "type": "object", "required": ["firstName", "lastName", "address"],
        "properties": { "firstName": { "type": "string", "maxLength": 100 }, "lastName": { "type": "string", "maxLength": 100 }, "address": { "type": "string", "maxLength": 250 } }
      },
      "AccountType": {
        "type": "string",
        "enum": ["EVERYDAY", "SAVINGS", "BUSINESS"]
      },
      "OwnershipType": {
        "type": "string",
        "enum": ["SINGLE", "JOINT"]
      },
      "CreateAccountRequest": {
        "type": "object",
        "required": ["type"],
        "properties": {
          "type": { "$ref": "#/components/schemas/AccountType" },
          "displayName": { "type": "string", "maxLength": 80, "nullable": true }
        }
      },
      "CreateJointAccountRequest": {
        "type": "object",
        "required": ["type", "coOwnerEmail"],
        "properties": {
          "type": { "$ref": "#/components/schemas/AccountType" },
          "displayName": { "type": "string", "maxLength": 80, "nullable": true },
          "coOwnerEmail": { "type": "string", "format": "email", "description": "Normalized email of a different active registered customer." }
        }
      },
      "AccountOwner": {
        "type": "object",
        "required": ["id", "email", "firstName", "lastName"],
        "properties": {
          "id": { "type": "string", "format": "uuid" },
          "email": { "type": "string", "format": "email" },
          "firstName": { "type": "string" },
          "lastName": { "type": "string" }
        }
      },
      "Account": {
        "type": "object",
        "description": "One account record. customerId remains creator/legacy primary-owner metadata; authorization permits either owner listed in owners.",
        "required": ["id", "accountNumber", "customerId", "ownershipType", "owners", "type", "balanceCents", "currency", "createdAt", "updatedAt"],
        "properties": {
          "id": { "type": "string", "format": "uuid" },
          "accountNumber": { "type": "string", "example": "EXB-123456789" },
          "customerId": { "type": "string", "format": "uuid" },
          "ownershipType": { "$ref": "#/components/schemas/OwnershipType" },
          "owners": { "type": "array", "minItems": 1, "maxItems": 2, "description": "Complete safe owner set in primary-owner then co-owner order.", "items": { "$ref": "#/components/schemas/AccountOwner" } },
          "type": { "$ref": "#/components/schemas/AccountType" },
          "displayName": { "type": "string", "nullable": true },
          "balanceCents": { "type": "integer", "minimum": 0, "example": 100000000 },
          "currency": { "type": "string", "enum": ["AUD"] },
          "createdAt": { "type": "string", "format": "date-time" },
          "updatedAt": { "type": "string", "format": "date-time" }
        }
      },
      "CreateTransferRequest": {
        "type": "object",
        "required": ["sourceAccountId", "destinationAccountNumber", "amountCents"],
        "properties": {
          "sourceAccountId": { "type": "string", "format": "uuid" },
          "destinationAccountNumber": { "type": "string" },
          "amountCents": { "type": "integer", "minimum": 1 },
          "description": { "type": "string", "maxLength": 140, "nullable": true }
        }
      },
      "Transfer": {
        "type": "object",
        "required": ["id", "sourceAccountId", "destinationAccountId", "sourceAccountNumber", "destinationAccountNumber", "amountCents", "createdAt"],
        "properties": {
          "id": { "type": "string", "format": "uuid" },
          "sourceAccountId": { "type": "string", "format": "uuid" },
          "destinationAccountId": { "type": "string", "format": "uuid" },
          "sourceAccountNumber": { "type": "string" },
          "destinationAccountNumber": { "type": "string" },
          "amountCents": { "type": "integer", "minimum": 1 },
          "description": { "type": "string", "nullable": true },
          "createdAt": { "type": "string", "format": "date-time" }
        }
      },
      "Transaction": {
        "type": "object",
        "required": ["id", "method", "direction", "amountCents", "counterpartyAccountNumber", "counterpartyLabel", "customerReference", "createdAt"],
        "properties": {
          "id": { "type": "string", "format": "uuid" },
          "method": { "type": "string", "enum": ["TRANSFER", "BANK_ACCOUNT", "PAYID", "BPAY"] },
          "direction": { "type": "string", "enum": ["SENT", "RECEIVED"] },
          "amountCents": { "type": "integer", "minimum": 1 },
          "description": { "type": "string", "nullable": true },
          "counterpartyAccountNumber": { "type": "string", "nullable": true, "description": "Null for outgoing PayID and BPAY entries. Incoming PayID may show the source account but never the PayID-mapped destination account." },
          "counterpartyLabel": { "type": "string" },
          "customerReference": { "type": "string", "nullable": true },
          "createdAt": { "type": "string", "format": "date-time" }
        }
      },
      "PaymentRequest": {
        "oneOf": [
          { "$ref": "#/components/schemas/BankAccountPaymentRequest" },
          { "$ref": "#/components/schemas/PayIdPaymentRequest" },
          { "$ref": "#/components/schemas/BpayPaymentRequest" }
        ],
        "discriminator": { "propertyName": "method", "mapping": { "BANK_ACCOUNT": "#/components/schemas/BankAccountPaymentRequest", "PAYID": "#/components/schemas/PayIdPaymentRequest", "BPAY": "#/components/schemas/BpayPaymentRequest" } }
      },
      "BankAccountPaymentRequest": {
        "type": "object", "additionalProperties": false,
        "required": ["method", "sourceAccountId", "destinationAccountNumber", "amountCents"],
        "properties": { "method": { "type": "string", "enum": ["BANK_ACCOUNT"] }, "sourceAccountId": { "type": "string" }, "destinationAccountNumber": { "type": "string" }, "amountCents": { "type": "integer", "minimum": 1 }, "description": { "type": "string", "maxLength": 140 } }
      },
      "PayIdPaymentRequest": {
        "type": "object", "additionalProperties": false,
        "required": ["method", "sourceAccountId", "payId", "amountCents"],
        "properties": { "method": { "type": "string", "enum": ["PAYID"] }, "sourceAccountId": { "type": "string" }, "payId": { "type": "string", "format": "email", "description": "Email PayID, normalized to lowercase." }, "amountCents": { "type": "integer", "minimum": 1 }, "description": { "type": "string", "maxLength": 140 } }
      },
      "BpayPaymentRequest": {
        "type": "object", "additionalProperties": false,
        "required": ["method", "sourceAccountId", "billerCode", "customerReference", "amountCents"],
        "properties": { "method": { "type": "string", "enum": ["BPAY"] }, "sourceAccountId": { "type": "string" }, "billerCode": { "type": "string", "pattern": "^[0-9]+$" }, "customerReference": { "type": "string", "pattern": "^[0-9]+$" }, "amountCents": { "type": "integer", "minimum": 1 }, "description": { "type": "string", "maxLength": 140 } }
      },
      "PaymentResolution": {
        "type": "object",
        "description": "Safe review projection. Method-specific fields not applicable to the selected method are omitted.",
        "required": ["method", "sourceAccountNumber", "amountCents", "description", "payeeName"],
        "properties": { "method": { "type": "string", "enum": ["BANK_ACCOUNT", "PAYID", "BPAY"] }, "sourceAccountNumber": { "type": "string" }, "amountCents": { "type": "integer", "minimum": 1 }, "description": { "type": "string", "nullable": true }, "payeeName": { "type": "string" }, "destinationAccountNumber": { "type": "string", "nullable": true }, "payId": { "type": "string", "format": "email", "nullable": true }, "billerCode": { "type": "string", "nullable": true }, "customerReference": { "type": "string", "nullable": true } }
      },
      "PaymentReceipt": {
        "allOf": [
          { "$ref": "#/components/schemas/PaymentResolution" },
          { "type": "object", "required": ["id", "createdAt"], "properties": { "id": { "type": "string", "format": "uuid" }, "destinationAccountNumber": { "type": "string", "nullable": true }, "payId": { "type": "string", "format": "email", "nullable": true }, "billerCode": { "type": "string", "nullable": true }, "customerReference": { "type": "string", "nullable": true }, "createdAt": { "type": "string", "format": "date-time" } } }
        ]
      },
      "CreateScheduledTransferRequest": {
        "allOf": [{ "$ref": "#/components/schemas/CreateTransferRequest" }, { "type": "object", "required": ["scheduledFor"], "properties": { "scheduledFor": { "type": "string", "format": "date-time", "description": "Strict future UTC ISO-8601 instant chosen from the local UI picker." } } }]
      },
      "ScheduledTransfer": {
        "type": "object", "required": ["id", "sourceAccountId", "destinationAccountId", "sourceAccountNumber", "destinationAccountNumber", "amountCents", "scheduledFor", "status"],
        "properties": { "id": { "type": "string", "format": "uuid" }, "sourceAccountId": { "type": "string", "format": "uuid" }, "destinationAccountId": { "type": "string", "format": "uuid" }, "sourceAccountNumber": { "type": "string" }, "destinationAccountNumber": { "type": "string" }, "amountCents": { "type": "integer", "minimum": 1 }, "description": { "type": "string", "nullable": true }, "scheduledFor": { "type": "string", "format": "date-time" }, "status": { "type": "string", "enum": ["PENDING", "PROCESSING", "COMPLETED", "FAILED"] }, "failureReason": { "type": "string", "nullable": true }, "processedAt": { "type": "string", "format": "date-time", "nullable": true }, "transferId": { "type": "string", "format": "uuid", "nullable": true } }
      },
      "CardTransaction": {
        "type": "object", "required": ["id", "merchant", "amountCents", "occurredAt"], "properties": { "id": { "type": "string", "format": "uuid" }, "merchant": { "type": "string" }, "amountCents": { "type": "integer", "minimum": 1 }, "occurredAt": { "type": "string", "format": "date-time" } }
      },
      "Card": {
        "type": "object", "description": "Holder-owned card response. No PAN, CVV, PIN, or raw last-four field is exposed.", "required": ["id", "accountId", "maskedNumber", "status", "transactions"], "properties": { "id": { "type": "string", "format": "uuid" }, "accountId": { "type": "string", "format": "uuid" }, "maskedNumber": { "type": "string", "example": "•••• 1234" }, "status": { "type": "string", "enum": ["ACTIVE", "LOCKED", "DISABLED"] }, "transactions": { "type": "array", "minItems": 5, "maxItems": 5, "items": { "$ref": "#/components/schemas/CardTransaction" } } }
      },
      "ErrorResponse": {
        "type": "object",
        "required": ["error"],
        "properties": {
          "error": { "type": "string" }
        }
      }
    }
  }
}
