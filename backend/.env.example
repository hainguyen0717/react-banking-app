# Connection string for the SQLite database.
# Format: file:./relative/path/to/database.db
DATABASE_URL="file:./dev.db"

# Port the Express server should listen on.
PORT=4000

# Opening balance assigned by the server to every newly created account (AUD cents).
# The demo default below is $1,000,000.00.
DEFAULT_ACCOUNT_BALANCE_CENTS=100000000

# Opaque server-side session lifetimes.
SESSION_IDLE_TIMEOUT_SECONDS=1800
SESSION_ABSOLUTE_TIMEOUT_SECONDS=28800

# Exact credentialed browser origins, comma separated.
FRONTEND_ORIGINS="http://localhost:5173,http://127.0.0.1:5173"
NODE_ENV=development

# Seed configuration used by `npm run seed`
SEED_CUSTOMER_EMAIL="customer@example.com"
SEED_CUSTOMER_PASSWORD="changeMe123!"
SEED_CUSTOMER_FIRST_NAME="Sample"
SEED_CUSTOMER_LAST_NAME="User"
# Optional values
# SEED_CUSTOMER_PHONE="+1-555-0100"
# SEED_CUSTOMER_DATE_OF_BIRTH="1990-01-01"
# SEED_CUSTOMER_IS_ACTIVE=true
