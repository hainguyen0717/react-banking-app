generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model Customer {
  id           String   @id @default(uuid())
  email        String   @unique
  passwordHash String
  firstName    String
  lastName     String
  address      String?
  phoneNumber  String?
  dateOfBirth  DateTime?
  isActive     Boolean  @default(true)
  lastLoginAt  DateTime?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  primaryAccounts      Account[] @relation("PrimaryOwnerAccounts")
  jointlyOwnedAccounts Account[] @relation("CoOwnerAccounts")
  sessions              AuthSession[]
  scheduledTransfers    ScheduledTransfer[]
  cards                  Card[]
  payments               Payment[]
}

model AuthSession {
  id                String   @id @default(uuid())
  tokenHash         String   @unique
  customerId        String
  createdAt         DateTime @default(now())
  lastSeenAt        DateTime @default(now())
  absoluteExpiresAt DateTime
  customer          Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)

  @@index([customerId])
  @@index([absoluteExpiresAt])
}

model Account {
  id                   String     @id @default(uuid())
  accountNumber        String     @unique
  customerId           String
  coOwnerCustomerId    String?
  ownershipType        String     @default("SINGLE")
  type                 String
  displayName          String?
  balanceCents         Int
  currency             String     @default("AUD")
  createdAt            DateTime   @default(now())
  updatedAt            DateTime   @updatedAt
  primaryOwner         Customer   @relation("PrimaryOwnerAccounts", fields: [customerId], references: [id], onDelete: Cascade)
  coOwner              Customer?  @relation("CoOwnerAccounts", fields: [coOwnerCustomerId], references: [id], onDelete: Restrict)
  outgoingTransfers    Transfer[] @relation("OutgoingTransfers")
  incomingTransfers    Transfer[] @relation("IncomingTransfers")
  scheduledOutgoingTransfers ScheduledTransfer[] @relation("ScheduledOutgoingTransfers")
  scheduledIncomingTransfers ScheduledTransfer[] @relation("ScheduledIncomingTransfers")
  cards                Card[]
  payIdDirectoryEntries PayIdDirectoryEntry[]
  outgoingPayments     Payment[] @relation("OutgoingPayments")

  @@index([customerId])
  @@index([coOwnerCustomerId])
}

model Transfer {
  id                   String   @id @default(uuid())
  sourceAccountId      String
  destinationAccountId String
  amountCents          Int
  description          String?
  createdAt            DateTime @default(now())
  sourceAccount        Account  @relation("OutgoingTransfers", fields: [sourceAccountId], references: [id], onDelete: Restrict)
  destinationAccount   Account  @relation("IncomingTransfers", fields: [destinationAccountId], references: [id], onDelete: Restrict)
  scheduledTransfer    ScheduledTransfer?
  payment              Payment?

  @@index([sourceAccountId, createdAt])
  @@index([destinationAccountId, createdAt])
}

model PayIdDirectoryEntry {
  id          String    @id @default(uuid())
  type        String    @default("EMAIL")
  value       String    @unique
  displayName String
  accountId   String
  isActive    Boolean   @default(true)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  account     Account   @relation(fields: [accountId], references: [id], onDelete: Restrict)
  payments    Payment[]

  @@index([accountId])
}

model BpayBiller {
  id              String    @id @default(uuid())
  billerCode      String    @unique
  name            String
  referenceLength Int
  isActive        Boolean   @default(true)
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
  payments        Payment[]
}

model Payment {
  id                               String               @id @default(uuid())
  customerId                       String
  sourceAccountId                  String
  method                           String
  amountCents                      Int
  description                      String?
  transferId                       String?              @unique
  payIdDirectoryEntryId            String?
  bpayBillerId                     String?
  customerReference                String?
  sourceAccountNumberSnapshot      String
  payeeNameSnapshot                String
  destinationAccountNumberSnapshot String?
  payIdSnapshot                    String?
  billerCodeSnapshot               String?
  createdAt                        DateTime             @default(now())
  customer                         Customer             @relation(fields: [customerId], references: [id], onDelete: Restrict)
  sourceAccount                    Account              @relation("OutgoingPayments", fields: [sourceAccountId], references: [id], onDelete: Restrict)
  transfer                         Transfer?            @relation(fields: [transferId], references: [id], onDelete: Restrict)
  payIdDirectoryEntry              PayIdDirectoryEntry? @relation(fields: [payIdDirectoryEntryId], references: [id], onDelete: Restrict)
  bpayBiller                       BpayBiller?          @relation(fields: [bpayBillerId], references: [id], onDelete: Restrict)

  @@index([customerId, createdAt])
  @@index([sourceAccountId, createdAt])
  @@index([payIdDirectoryEntryId])
  @@index([bpayBillerId])
}

model ScheduledTransfer {
  id                   String    @id @default(uuid())
  customerId           String
  sourceAccountId      String
  destinationAccountId String
  amountCents          Int
  description          String?
  scheduledFor         DateTime
  status               String    @default("PENDING")
  failureReason        String?
  processedAt          DateTime?
  transferId           String?   @unique
  createdAt            DateTime  @default(now())
  updatedAt            DateTime  @updatedAt
  customer             Customer  @relation(fields: [customerId], references: [id], onDelete: Cascade)
  sourceAccount        Account   @relation("ScheduledOutgoingTransfers", fields: [sourceAccountId], references: [id], onDelete: Restrict)
  destinationAccount   Account   @relation("ScheduledIncomingTransfers", fields: [destinationAccountId], references: [id], onDelete: Restrict)
  transfer             Transfer? @relation(fields: [transferId], references: [id], onDelete: SetNull)

  @@index([customerId, scheduledFor])
  @@index([status, scheduledFor])
}

model Card {
  id           String            @id @default(uuid())
  customerId   String
  accountId    String
  lastFour     String
  status       String            @default("ACTIVE")
  createdAt    DateTime          @default(now())
  updatedAt    DateTime          @updatedAt
  customer     Customer          @relation(fields: [customerId], references: [id], onDelete: Cascade)
  account      Account           @relation(fields: [accountId], references: [id], onDelete: Restrict)
  transactions CardTransaction[]

  @@index([customerId, createdAt])
  @@index([accountId])
}

model CardTransaction {
  id             String   @id @default(uuid())
  cardId         String
  sampleSequence Int
  merchant       String
  amountCents    Int
  occurredAt     DateTime
  card           Card     @relation(fields: [cardId], references: [id], onDelete: Cascade)

  @@unique([cardId, sampleSequence])
  @@index([cardId, occurredAt])
}
