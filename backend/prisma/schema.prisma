generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model Customer {
  id           String   @id @default(uuid())
  email        String   @unique
  passwordHash String
  firstName    String
  lastName     String
  phoneNumber  String?
  dateOfBirth  DateTime?
  isActive     Boolean  @default(true)
  lastLoginAt  DateTime?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  primaryAccounts      Account[] @relation("PrimaryOwnerAccounts")
  jointlyOwnedAccounts Account[] @relation("CoOwnerAccounts")
  sessions              AuthSession[]
}

model AuthSession {
  id                String   @id @default(uuid())
  tokenHash         String   @unique
  customerId        String
  createdAt         DateTime @default(now())
  lastSeenAt        DateTime @default(now())
  absoluteExpiresAt DateTime
  customer          Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)

  @@index([customerId])
  @@index([absoluteExpiresAt])
}

model Account {
  id                   String     @id @default(uuid())
  accountNumber        String     @unique
  customerId           String
  coOwnerCustomerId    String?
  ownershipType        String     @default("SINGLE")
  type                 String
  displayName          String?
  balanceCents         Int
  currency             String     @default("AUD")
  createdAt            DateTime   @default(now())
  updatedAt            DateTime   @updatedAt
  primaryOwner         Customer   @relation("PrimaryOwnerAccounts", fields: [customerId], references: [id], onDelete: Cascade)
  coOwner              Customer?  @relation("CoOwnerAccounts", fields: [coOwnerCustomerId], references: [id], onDelete: Restrict)
  outgoingTransfers    Transfer[] @relation("OutgoingTransfers")
  incomingTransfers    Transfer[] @relation("IncomingTransfers")

  @@index([customerId])
  @@index([coOwnerCustomerId])
}

model Transfer {
  id                   String   @id @default(uuid())
  sourceAccountId      String
  destinationAccountId String
  amountCents          Int
  description          String?
  createdAt            DateTime @default(now())
  sourceAccount        Account  @relation("OutgoingTransfers", fields: [sourceAccountId], references: [id], onDelete: Restrict)
  destinationAccount   Account  @relation("IncomingTransfers", fields: [destinationAccountId], references: [id], onDelete: Restrict)

  @@index([sourceAccountId, createdAt])
  @@index([destinationAccountId, createdAt])
}
